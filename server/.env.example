# ==============================================================================
# TPB Backend — Environment Configuration (.env)
# ==============================================================================

# Secret key used for JWT signing. Replace in production!
SECRET_KEY=tpb-fyp-super-secret-key-change-in-prod-2024

# Algorithm & token expiry
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database URL (defaults to sqlite:///./app.db)
DATABASE_URL=sqlite:///./app.db

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional: OpenAI API key for dynamic AI scenario generation
OPENAI_API_KEY=your-openai-api-key-here

# ------------------------------------------------------------------------------
# Password Reset & Email Configuration (SMTP)
# ------------------------------------------------------------------------------
# URL of the frontend application where the user will be directed to reset password
FRONTEND_URL=http://localhost:5173

# Expiry duration for password reset links in minutes (default: 30)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# SMTP Server Settings (Leave empty for development to log reset links in backend console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@prisma-defense.edu.pk
SMTP_USE_TLS=true

# Development mode — set to true ONLY for local dev with no real SMTP.
# When true (and SMTP_HOST is unset), POST /auth/forgot-password returns the
# reset URL in the API response. NEVER enable in production.
DEBUG=false
