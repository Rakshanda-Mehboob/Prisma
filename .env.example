# ==============================================================================
# TPB Cyberbullying Intervention System — Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or server/.env and client/.env) before running.
# Never commit .env files containing production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------

# Secret key used for signing JWT authentication tokens.
# In production, generate a secure 256-bit random key:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=tpb-fyp-super-secret-key-change-in-prod-2024

# JWT signing algorithm (HS256 recommended)
ALGORITHM=HS256

# JWT token expiration in minutes (default: 60 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database connection URL (defaults to local SQLite database in server/app.db)
DATABASE_URL=sqlite:///./app.db

# Allowed CORS origins for the backend (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Optional: Google Gemini API Key for dynamic AI scenario generation
# If left unset, the system uses an advanced local contextual synthesizer fallback.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------

# Base URL for the FastAPI backend API
VITE_API_URL=http://localhost:8000
